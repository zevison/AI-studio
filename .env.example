# Seedance Studio V4.2.8.10 local defaults; never put real API keys in distributable ZIP.
HOST=127.0.0.1
PORT=8765
OPEN_BROWSER=1
TUNNEL_ENABLED=1
VIDEO_MODEL=doubao-seedance-2-5-260628
IMAGE_MODEL=gpt-image-2.5-sunburst-c
MAX_CONCURRENT_VIDEO_TASKS=10
# Remote version check. Empty = official public release feed (default).
# Override with any https://.../latest-release.json URL, or set to "off" to disable.
# NOTE: the packaged EXE reads .env from %LOCALAPPDATA%\SeedanceStudio\.env,
#       not from the installation folder.
VERSION_CHECK_URL=
# Configure OpenLux / Bright Data credentials in Studio Settings (Windows user encrypted storage).
